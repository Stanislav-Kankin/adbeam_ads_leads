# Скопировать в .env и заполнить. .env в git не попадает.
ADS_LEADS_DATA_DIR=data
ADS_LEADS_PORT=8000

# Вход в интерфейс. На сервере пароль обязателен, локально можно оставить пустым.
ADS_LEADS_AUTH_USER=adbeam
ADS_LEADS_AUTH_PASSWORD=
# Личные логины через запятую (данные у всех общие): stas:пароль1,nonna:пароль2
ADS_LEADS_AUTH_USERS=

# Порт на сервере (127.0.0.1:<порт> → nginx), только для docker compose.
ADS_LEADS_PUBLISH_PORT=8021

ADS_LEADS_KEYSO_API_TOKEN=
ADS_LEADS_KEYSO_BASE=msk
